---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeView, { type HomeContent } from '../components/HomeView.astro';
import { agent } from '../config/site';
import { buildTitle, faqLd } from '../lib/seo';

const title = buildTitle('San Gabriel Valley Vietnamese Mortgage Broker | Bao Nguyen', { brand: false });
const description =
  'Bao Nguyen is a Vietnamese mortgage broker, loan officer and realtor in the San Gabriel Valley. Refinance, cash out or buy a home in Vietnamese or English.';

const c: HomeContent = {
  eyebrow: 'Vietnamese realtor & loan officer · San Gabriel Valley',
  h1: 'San Gabriel Valley Vietnamese mortgage broker and realtor',
  lead: `${agent.name} is a San Gabriel Valley Vietnamese mortgage broker and realtor. As a licensed Vietnamese loan officer, he helps families in Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City and nearby cities refinance, take cash out, and buy or sell a home, with one person handling the loan and the home search in Tiếng Việt or English.`,
  cardLabel: 'About your loan officer',
  photoAlt: 'Bao Nguyen, mortgage broker and realtor',
  langs: 'English · Tiếng Việt',
  helpH2: 'What I can help you with',
  helps: [
    { h: 'Refinance', p: 'Replace your current loan to change the rate, the term, or the monthly payment.' },
    { h: 'Take cash out', p: 'Turn home equity into cash with a cash-out refinance or a home equity line.' },
    { h: 'Buy a home', p: 'Get pre-approved, then tour homes with the same person who arranges the loan, so your offer is ready when you find the right one.' },
    { h: 'Sell a home', p: 'Price, list and sell with a San Gabriel Valley realtor who also has the financing for your next move lined up.' },
  ],
  citiesH2: 'Cities I serve',
  citiesIntro: "I work across the San Gabriel Valley, from the office in West Covina. The cities I'm asked about most:",
  allAreas: 'All areas',
  programsH2: 'Loan programs',
  programsIntro: 'As a mortgage broker, Bao compares programs from multiple wholesale lenders to find the one that fits your situation.',
  programs: [
    { h: 'First-time home buyers', p: 'Low down payment options and help understanding every step, from pre-approval to keys.' },
    { h: 'FHA and conventional loans', p: 'FHA loans with flexible credit guidelines, and conventional loans up to the Los Angeles County limit.' },
    { h: 'Self-employed borrowers', p: 'Bank-statement and other non-traditional income options for business owners and independent contractors.' },
    { h: 'Refinance and cash-out', p: 'Lower your payment, shorten your term, or turn home equity into cash for renovations or debt payoff.' },
    { h: 'VA loans', p: 'Home loans for eligible veterans, service members and surviving spouses, often with no down payment.' },
    { h: 'Down payment assistance', p: 'CalHFA programs statewide, plus Los Angeles County help in participating cities.' },
  ],
  stepsH2: 'How it works',
  steps: [
    { h: 'Share your goals', p: 'Call or text. Tell Bao what you want to do: buy, refinance, take cash out or sell.' },
    { h: 'Get your numbers', p: 'Get pre-approved to buy, or get a Loan Estimate showing the cost of a refinance.' },
    { h: 'Find the home or lock the loan', p: 'Search for homes with the same person handling your loan, or choose your refinance option.' },
    { h: 'Close', p: 'Bao coordinates escrow, the appraisal and the paperwork through to signing.' },
  ],
  faqH2: 'Frequently asked questions',
  faq: [
    ['Do you only help with loans, or with buying and selling too?', 'Both. Bao is a licensed mortgage loan originator and a real estate broker associate, so he can arrange your loan and represent you when you buy or sell.'],
    ['Is Bao a Vietnamese realtor as well as a loan officer?', 'Yes. Bao is a Vietnamese agent licensed for both real estate and mortgage lending, and he works in Vietnamese and English from the first call through closing.'],
    ['Which areas do you serve?', 'The whole San Gabriel Valley, including Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City, El Monte, Arcadia and West Covina, plus the rest of Los Angeles County.'],
    ['What does it cost to talk to you?', 'Nothing. The first conversation is free, and you get a Loan Estimate showing every cost before you commit to anything.'],
  ],
};
---
<BaseLayout title={title} description={description} path="/" crumbs={[{ name: 'Home', path: '/' }]} schema={[faqLd(c.faq, 'en')]}>
  <HomeView c={c} lang="en" />
</BaseLayout>
