---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeView, { type HomeContent } from '../components/HomeView.astro';
import { agent } from '../config/site';
import { buildTitle, faqLd } from '../lib/seo';

const title = buildTitle('San Gabriel Valley Mortgage Broker | Bao Nguyen', { brand: false });
const description =
  'Refinance, take cash out, or buy a home in the San Gabriel Valley with Bao Nguyen, a licensed mortgage broker and realtor. English and Vietnamese.';

const c: HomeContent = {
  eyebrow: 'Mortgage broker & realtor · San Gabriel Valley',
  h1: 'San Gabriel Valley mortgage broker who also helps you buy and sell',
  lead: `${agent.name} helps families in Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City and the rest of the San Gabriel Valley refinance, take cash out, and buy or sell a home. One licensed person handles the loan and the home search, in English or Vietnamese.`,
  cardLabel: 'About your loan officer',
  photoAlt: 'Bao Nguyen, mortgage broker and realtor',
  langs: 'English · Tiếng Việt',
  helpH2: 'What I can help you with',
  helps: [
    { h: 'Refinance', p: 'Replace your current loan to change the rate, the term, or the monthly payment.' },
    { h: 'Take cash out', p: 'Turn home equity into cash with a cash-out refinance or a home equity line.' },
    { h: 'Buy a home', p: 'Get pre-approved, then search for the home with the same person who arranges the loan.' },
    { h: 'Sell a home', p: 'Price, list and sell, with financing advice for your next move already in place.' },
  ],
  citiesH2: 'Cities I serve',
  citiesIntro: "I work across the San Gabriel Valley, from the office in West Covina. The cities I'm asked about most:",
  allAreas: 'All areas',
  faqH2: 'Frequently asked questions',
  faq: [
    ['Do you only help with loans, or with buying and selling too?', 'Both. Bao is a licensed mortgage loan originator and a real estate broker associate, so he can arrange your loan and represent you when you buy or sell.'],
    ['Do you speak Vietnamese?', 'Yes. Bao works in Vietnamese and English, from the first call through closing.'],
    ['Which areas do you serve?', 'The whole San Gabriel Valley, including Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City, El Monte, Arcadia and West Covina, plus the rest of Los Angeles County.'],
    ['What does it cost to talk to you?', 'Nothing. The first conversation is free, and you get a Loan Estimate showing every cost before you commit to anything.'],
  ],
};
---
<BaseLayout title={title} description={description} path="/" crumbs={[{ name: 'Home', path: '/' }]} schema={[faqLd(c.faq, 'en')]}>
  <HomeView c={c} lang="en" />
</BaseLayout>
