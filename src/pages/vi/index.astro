---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView, { type HomeContent } from '../../components/HomeView.astro';
import { agent } from '../../config/site';
import { faqLd } from '../../lib/seo';

const title = 'Môi giới vay mua nhà San Gabriel Valley | Bao Nguyen';
const description =
  'Tái tài trợ, rút tiền mặt từ nhà, hoặc mua bán nhà ở San Gabriel Valley với Bao Nguyen, chuyên viên môi giới vay và địa ốc có giấy phép. Nói tiếng Việt.';

const c: HomeContent = {
  eyebrow: 'Môi giới vay & địa ốc · San Gabriel Valley',
  h1: 'Môi giới vay mua nhà tại San Gabriel Valley, kiêm giúp bạn mua và bán nhà',
  lead: `${agent.name} giúp các gia đình ở Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City và khắp San Gabriel Valley tái tài trợ, rút tiền mặt từ giá trị căn nhà, và mua hoặc bán nhà. Một người có giấy phép lo cả khoản vay lẫn việc tìm nhà, bằng tiếng Việt hoặc tiếng Anh.`,
  cardLabel: 'Về chuyên viên cho vay của bạn',
  photoAlt: 'Bao Nguyen, chuyên viên môi giới vay và địa ốc',
  langs: 'Tiếng Việt · English',
  helpH2: 'Tôi có thể giúp gì cho bạn',
  helps: [
    { h: 'Tái tài trợ (Refinance)', p: 'Thay khoản vay hiện tại để đổi lãi suất, thời hạn vay, hoặc số tiền trả hàng tháng.' },
    { h: 'Rút tiền mặt từ nhà', p: 'Biến phần giá trị tích lũy của căn nhà thành tiền mặt bằng tái tài trợ rút tiền mặt (cash-out) hoặc hạn mức tín dụng theo giá trị nhà (HELOC).' },
    { h: 'Mua nhà', p: 'Được duyệt trước (pre-approval), rồi tìm nhà với chính người lo khoản vay cho bạn.' },
    { h: 'Bán nhà', p: 'Định giá, đăng bán và bán nhà, đồng thời có sẵn kế hoạch tài chính cho căn nhà kế tiếp.' },
  ],
  citiesH2: 'Các thành phố tôi phục vụ',
  citiesIntro: 'Tôi làm việc khắp San Gabriel Valley, từ văn phòng ở West Covina. Những thành phố được hỏi đến nhiều nhất:',
  allAreas: 'Tất cả khu vực',
  faqH2: 'Câu hỏi thường gặp',
  faq: [
    ['Bạn chỉ giúp về khoản vay, hay cả mua bán nhà?', 'Cả hai. Bao là chuyên viên cho vay có giấy phép kiêm môi giới địa ốc, nên có thể lo khoản vay và đại diện cho bạn khi mua hoặc bán nhà.'],
    ['Bạn có nói tiếng Việt không?', 'Có. Bao làm việc bằng tiếng Việt và tiếng Anh, từ cuộc gọi đầu tiên cho đến ngày ký giấy tờ.'],
    ['Bạn phục vụ những khu vực nào?', 'Toàn bộ San Gabriel Valley, gồm Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City, El Monte, Arcadia và West Covina, cùng các nơi khác trong Quận Los Angeles.'],
    ['Nói chuyện với bạn có mất phí không?', 'Không. Cuộc tư vấn đầu tiên miễn phí, và bạn sẽ nhận Bản Ước tính Khoản vay (Loan Estimate) ghi rõ mọi chi phí trước khi quyết định.'],
  ],
};
---
<BaseLayout title={title} description={description} path="/vi/" lang="vi" crumbs={[{ name: 'Trang chủ', path: '/vi/' }]} schema={[faqLd(c.faq, 'vi')]}>
  <HomeView c={c} lang="vi" />
</BaseLayout>
