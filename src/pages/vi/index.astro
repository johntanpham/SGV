---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeView, { type HomeContent } from '../../components/HomeView.astro';
import { agent } from '../../config/site';
import { faqLd } from '../../lib/seo';

const title = 'Môi giới vay mua nhà người Việt ở San Gabriel Valley';
const description =
  'Tái tài trợ, rút tiền mặt từ nhà, hoặc mua bán nhà ở San Gabriel Valley với Bao Nguyen, chuyên viên môi giới vay và địa ốc có giấy phép. Nói tiếng Việt.';

const c: HomeContent = {
  eyebrow: 'Realtor & chuyên viên cho vay người Việt · San Gabriel Valley',
  h1: 'Môi giới vay mua nhà và địa ốc người Việt tại San Gabriel Valley',
  lead: `${agent.name} là người môi giới vay mua nhà và địa ốc người Việt tại San Gabriel Valley. Là chuyên viên cho vay có giấy phép, anh giúp các gia đình ở Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City và các thành phố lân cận tái tài trợ, rút tiền mặt từ nhà, và mua hoặc bán nhà, với một người lo cả khoản vay lẫn việc tìm nhà, bằng tiếng Việt hoặc tiếng Anh.`,
  cardLabel: 'Về chuyên viên cho vay của bạn',
  photoAlt: 'Bao Nguyen, chuyên viên môi giới vay và địa ốc',
  langs: 'Tiếng Việt · English',
  helpH2: 'Tôi có thể giúp gì cho bạn',
  helps: [
    { h: 'Tái tài trợ (Refinance)', p: 'Thay khoản vay hiện tại để đổi lãi suất, thời hạn vay, hoặc số tiền trả hàng tháng.' },
    { h: 'Rút tiền mặt từ nhà', p: 'Biến phần giá trị tích lũy của căn nhà thành tiền mặt bằng tái tài trợ rút tiền mặt (cash-out) hoặc hạn mức tín dụng theo giá trị nhà (HELOC).' },
    { h: 'Mua nhà', p: 'Được duyệt trước (pre-approval), rồi tìm nhà với chính người lo khoản vay cho bạn.' },
    { h: 'Bán nhà', p: 'Định giá, đăng bán và bán nhà với một realtor ở San Gabriel Valley, đồng thời có sẵn kế hoạch tài chính cho căn nhà kế tiếp.' },
  ],
  citiesH2: 'Các thành phố tôi phục vụ',
  citiesIntro: 'Tôi làm việc khắp San Gabriel Valley, từ văn phòng ở West Covina. Những thành phố được hỏi đến nhiều nhất:',
  allAreas: 'Tất cả khu vực',
  programsH2: 'Các chương trình vay',
  programsIntro: 'Là người môi giới vay, Bao so sánh chương trình từ nhiều nhà cho vay bán sỉ để tìm lựa chọn phù hợp với hoàn cảnh của bạn.',
  programs: [
    { h: 'Người mua nhà lần đầu', p: 'Lựa chọn trả trước thấp và hướng dẫn từng bước, từ duyệt trước cho đến ngày nhận chìa khóa.' },
    { h: 'Vay FHA và vay thông thường', p: 'Vay FHA với tiêu chuẩn tín dụng linh hoạt, và vay thông thường (conventional) tới hạn mức của Quận Los Angeles.' },
    { h: 'Người tự kinh doanh', p: 'Chương trình dùng sao kê ngân hàng (bank statement) và các cách chứng minh thu nhập khác cho chủ doanh nghiệp và người làm tự do.' },
    { h: 'Tái tài trợ và rút tiền mặt', p: 'Giảm tiền trả hàng tháng, rút ngắn thời hạn vay, hoặc rút tiền mặt từ giá trị nhà để sửa nhà hay trả nợ.' },
    { h: 'Vay VA', p: 'Khoản vay mua nhà cho cựu quân nhân, quân nhân tại ngũ và người phối ngẫu còn sống đủ điều kiện, thường không cần trả trước.' },
    { h: 'Hỗ trợ tiền trả trước', p: 'Các chương trình CalHFA toàn tiểu bang, cùng hỗ trợ của Quận Los Angeles tại các thành phố tham gia.' },
  ],
  stepsH2: 'Quy trình làm việc',
  steps: [
    { h: 'Chia sẻ mục tiêu', p: 'Gọi hoặc nhắn tin. Cho Bao biết bạn muốn mua nhà, tái tài trợ, rút tiền mặt hay bán nhà.' },
    { h: 'Biết rõ con số', p: 'Được duyệt trước để mua nhà, hoặc nhận Bản Ước tính Khoản vay (Loan Estimate) cho chi phí tái tài trợ.' },
    { h: 'Tìm nhà hoặc khóa khoản vay', p: 'Tìm nhà với chính người lo khoản vay cho bạn, hoặc chọn phương án tái tài trợ.' },
    { h: 'Hoàn tất giao dịch', p: 'Bao phối hợp escrow, thẩm định giá và giấy tờ cho đến ngày ký.' },
  ],
  faqH2: 'Câu hỏi thường gặp',
  faq: [
    ['Bạn chỉ giúp về khoản vay, hay cả mua bán nhà?', 'Cả hai. Bao là chuyên viên cho vay có giấy phép kiêm môi giới địa ốc, nên có thể lo khoản vay và đại diện cho bạn khi mua hoặc bán nhà.'],
    ['Bạn có nói tiếng Việt không?', 'Có. Bao làm việc bằng tiếng Việt và tiếng Anh, từ cuộc gọi đầu tiên cho đến ngày ký giấy tờ.'],
    ['Bạn phục vụ những khu vực nào?', 'Toàn bộ San Gabriel Valley, gồm Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City, El Monte, Arcadia và West Covina, cùng các nơi khác trong Quận Los Angeles.'],
    ['Nói chuyện với bạn có mất phí không?', 'Không. Cuộc tư vấn đầu tiên miễn phí, và bạn sẽ nhận Bản Ước tính Khoản vay (Loan Estimate) ghi rõ mọi chi phí trước khi quyết định.'],
  ],
};
---
<BaseLayout title={title} description={description} path="/vi/" lang="vi" crumbs={[{ name: 'Trang chủ', path: '/vi/' }]} schema={[faqLd(c.faq, 'vi')]}>
  <HomeView c={c} lang="vi" />
</BaseLayout>
