---
import { agent, formatPhone, telHref } from '../config/site';
import { t, type Lang } from '../i18n/strings';
interface Props {
  text: string;
  lang: Lang;
  /** Final, larger call-to-action at the end of a page. */
  strong?: boolean;
}
const { text, lang, strong = false } = Astro.props;
const tr = t(lang);
---
<aside class:list={['cta-band', { strong }]}>
  <p class="cta-text">{strong ? (lang === 'vi' ? `Liên hệ Bao: ${text}` : `Talk to Bao: ${text}`) : text}</p>
  <div class="cta-buttons">
    <a class="btn btn-primary" href={telHref(agent.phone)}>{tr.call} {formatPhone(agent.phone)}</a>
    <a class="btn btn-ghost" href={`sms:+1${agent.phone}`}>{tr.text}</a>
  </div>
</aside>

<style>
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--jade-100);
    border-radius: var(--radius);
  }
  .cta-text {
    margin: 0;
    font-weight: 700;
    color: var(--jade-900);
    font-size: 1.0625rem;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .strong {
    background: var(--jade-900);
  }
  .strong .cta-text {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.375rem;
  }
  .strong .btn-primary {
    background: var(--white);
    color: var(--jade-900);
  }
  .strong .btn-primary:hover {
    background: var(--sand-100);
    color: var(--jade-900);
  }
  .strong .btn-ghost {
    color: var(--white);
    border-color: var(--white);
  }
  .strong .btn-ghost:hover {
    background: var(--jade-800);
  }
</style>
