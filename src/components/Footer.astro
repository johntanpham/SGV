---
import { site, agent, brokerage, mortgageCompany, requiredBeforeLaunch, verifyLinks, formatPhone, telHref } from '../config/site';
const missing = requiredBeforeLaunch.filter((r) => !r.value).map((r) => r.label);
import EqualHousing from './EqualHousing.astro';
import { t, viPath, type Lang } from '../i18n/strings';
import { serviceLinks } from '../content/services';
import { infoFooterLinks } from '../content/info';
import { cities } from '../data/cities';
interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const tr = t(lang);
const services = serviceLinks(lang);
const areaHref = (slug: string) => (lang === 'vi' ? viPath(`/areas/${slug}/`) : `/areas/${slug}/`);
const info = infoFooterLinks(lang);
const year = new Date().getFullYear();
const a = brokerage.address;
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="f-col f-wide">
      <p class="f-brand">{site.name}</p>
      <p>
        {agent.name}, {agent.title}<br />
        <a href={telHref(agent.phone)}>{formatPhone(agent.phone)}</a><br />
        <a href={`mailto:${agent.email}`}>{agent.email}</a><br />
        {tr.languages}
      </p>
    </div>
    <div class="f-col f-wide">
      <p class="f-head">{tr.office}</p>
      <address>
        {brokerage.name}<br />
        {a.street}<br />
        {a.city}, {a.region} {a.postalCode}
      </address>
    </div>
    <nav class="f-col" aria-label={lang === 'vi' ? 'Dịch vụ' : 'Services'}>
      <p class="f-head">{lang === 'vi' ? 'Dịch vụ' : 'Services'}</p>
      <ul>
        {services.map((sv) => <li><a href={sv.href}>{sv.label}</a></li>)}
      </ul>
    </nav>
    <nav class="f-col f-wide" aria-label={lang === 'vi' ? 'Khu vực' : 'Areas'}>
      <p class="f-head">{lang === 'vi' ? 'Khu vực' : 'Areas'}</p>
      <ul class="f-areas">
        {cities.map((ct) => <li><a href={areaHref(ct.slug)}>{ct.name}</a></li>)}
      </ul>
    </nav>
    {info.length > 0 && (
      <nav class="f-col" aria-label={tr.footerNav}>
        <p class="f-head">{tr.site}</p>
        <ul>
          {info.map((i) => (
            <li><a href={i.href}>{i.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <div class="wrap disclosures" id="licenses">
    <p>
      <strong>{agent.name}</strong>, {agent.title} · CA DRE #{agent.dreLicense} · NMLS #{agent.nmlsId}
      · <a href={verifyLinks.nmls} rel="noopener" target="_blank">{tr.verifyNmls}<span class="visually-hidden"> {tr.newTab}</span></a>
    </p>
    <p>
      {tr.mortgageVia} <strong>{mortgageCompany.legalName}</strong>, dba {mortgageCompany.dba}
      · NMLS #{mortgageCompany.nmlsId} · {mortgageCompany.regulator}{mortgageCompany.dreLicense ? <>, DRE #{mortgageCompany.dreLicense}</> : null}
    </p>
    <p>
      {tr.realEstate} <strong>{brokerage.legalName}</strong>, dba {brokerage.name} · {brokerage.regulator} · DRE #{brokerage.dreLicense}
    </p>
    <p>{tr.disclaimer}</p>
    {missing.length > 0 && <span hidden data-missing-before-launch={missing.join('; ')}></span>}
    <div class="bottom">
      <EqualHousing tone="light" />
      {tr.ehoNote && <span class="eho-note" lang="vi">({tr.ehoNote})</span>}
      <p class="copy">© {year} {brokerage.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--jade-900);
    color: #e9f2ef;
    margin-top: 4rem;
    padding-block: 2rem 1.25rem;
    font-size: 0.9375rem;
  }
  .site-footer a {
    color: #ffffff;
  }
  .grid {
    display: grid;
    gap: 1.25rem 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: row dense;
    align-items: start;
  }
  .f-wide {
    grid-column: 1 / -1;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 1.35fr 1.1fr 1fr 1.5fr 0.8fr;
    }
    .f-wide {
      grid-column: auto;
    }
  }
  .f-brand {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.4rem;
    line-height: 1.25;
  }
  .f-col p {
    margin-bottom: 0.25rem;
  }
  .f-head {
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0;
  }
  address {
    font-style: normal;
  }
  .f-areas {
    columns: 2;
    column-gap: 1rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .disclosures {
    border-top: 1px solid rgb(255 255 255 / 0.2);
    margin-top: 1.25rem;
    padding-top: 1rem;
    font-size: 0.8125rem;
    line-height: 1.55;
  }
  .disclosures p {
    margin-bottom: 0.5rem;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
  }
  .copy {
    margin: 0;
  }
  .eho-note {
    font-size: 0.8125rem;
  }
</style>
