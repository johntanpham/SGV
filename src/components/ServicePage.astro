---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import { serviceContent } from '../content/services';
import { t, type Lang } from '../i18n/strings';
import { ids, canonicalUrl, faqLd } from '../lib/seo';

interface Props {
  id: 'realtor' | 'sell' | 'buy' | 'loan';
  lang: Lang;
}
const { id, lang } = Astro.props;
const c = serviceContent(id, lang);
const tr = t(lang);
const home = lang === 'vi' ? '/vi/' : '/';
const crumbs = [{ name: tr.home, path: home }, ...(c.parent ? [c.parent] : []), { name: c.crumb, path: c.path }];
const schema = [
  {
    '@type': 'Service',
    '@id': `${canonicalUrl(c.path)}#service`,
    name: c.h1,
    serviceType: c.serviceType,
    provider: { '@id': ids.agent },
    areaServed: { '@type': 'Place', name: 'San Gabriel Valley, Los Angeles County, California' },
    availableLanguage: ['en', 'vi'],
    inLanguage: lang,
  },
  faqLd(c.faq, lang),
];
---
<BaseLayout title={c.title} description={c.description} path={c.path} crumbs={crumbs} lang={lang} schema={schema}>
  <article class="wrap svc">
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    {c.blocks.map((b, i) =>
      b.kind === 'cta' ? (
        <CtaBand text={b.text} lang={lang} />
      ) : (
        <section aria-labelledby={`s${i}`}>
          <h2 id={`s${i}`}>{b.h2}</h2>
          {b.p?.map((x) => <p>{x}</p>)}
          {b.list && <ul class="ticks">{b.list.map((x) => <li>{x}</li>)}</ul>}
          {b.steps && <ol class="steps">{b.steps.map((x) => <li>{x}</li>)}</ol>}
          {b.link && <p><a class="more" href={b.link.href}>{b.link.label} →</a></p>}
        </section>
      ),
    )}
    <Faq heading={c.faqH2} items={c.faq} />
    <section aria-labelledby="related">
      <h2 id="related">{c.relatedH2}</h2>
      <ul class="pills">
        {c.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}
      </ul>
    </section>
    <CtaBand text={c.h1} lang={lang} strong />
  </article>
</BaseLayout>

<style>
  .svc {
    max-width: 52rem;
    padding-block: 1.5rem 0;
  }
  .lead {
    font-size: 1.1875rem;
    color: var(--ink-soft);
  }
  .ticks {
    padding-left: 1.25rem;
  }
  .ticks li {
    margin-bottom: 0.4rem;
  }
  .steps {
    padding-left: 1.5rem;
  }
  .steps li {
    margin-bottom: 0.4rem;
    font-weight: 600;
  }
  .more {
    font-weight: 700;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  .pills a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--jade-100);
    color: var(--jade-900);
    font-weight: 600;
    text-decoration: none;
  }
</style>
