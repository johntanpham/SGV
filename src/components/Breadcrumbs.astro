---
import type { Crumb } from '../lib/seo';
import { t, type Lang } from '../i18n/strings';
interface Props {
  crumbs: Crumb[];
  lang?: Lang;
}
const { crumbs, lang = 'en' } = Astro.props;
---
{crumbs.length > 1 && (
  <nav aria-label={t(lang).breadcrumb} class="crumbs wrap">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.75rem 0 0;
    font-size: 0.875rem;
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: 0.25rem;
    color: var(--ink-soft);
  }
  .crumbs a {
    display: inline-block;
    padding-block: 0.6rem;
  }
</style>
