---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cities, CENSUS_SOURCE } from '../data/cities';
import { cityFacts, usd } from '../i18n/city-copy';
import { loanLimits, hop } from '../data/loan-limits';
import { t, viPath, type Lang } from '../i18n/strings';
import Faq from './Faq.astro';
import { faqLd } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);
const vi = lang === 'vi';
const p = (path: string) => (vi ? viPath(path) : path);
const path = p('/areas/');
const copy = vi
  ? {
      title: 'Khu vực phục vụ: Môi giới vay mua nhà San Gabriel Valley',
      description: 'Bao Nguyen phục vụ Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City, El Monte, Arcadia, West Covina. Giá nhà và hạn mức vay từng thành phố.',
      crumb: 'Khu vực phục vụ',
      h1: 'Môi giới vay mua nhà khắp San Gabriel Valley',
      lead: `Tôi giúp cư dân San Gabriel Valley tái tài trợ, rút tiền mặt từ nhà và mua bán nhà, bằng tiếng Việt hoặc tiếng Anh. Mọi thành phố dưới đây thuộc Quận Los Angeles, nên hạn mức vay conforming năm ${loanLimits.year} là ${usd(loanLimits.conforming.oneUnit)} cho nhà một căn. Chọn thành phố của bạn để xem giá nhà, tỷ lệ chủ sở hữu và các chương trình hỗ trợ tiền trả trước áp dụng tại đó.`,
      value: 'Giá trị nhà trung vị',
      owners: 'Nhà do chủ ở',
      hopYes: 'Có chương trình HOP của quận',
      hopNo: 'Không thuộc chương trình HOP của quận',
      more: 'Không thấy thành phố của bạn? Tôi phục vụ toàn bộ San Gabriel Valley và cả Quận Los Angeles. Hãy gọi hoặc nhắn tin.',
      source: 'Nguồn',
    }
  : {
      title: 'Areas Served: San Gabriel Valley Mortgage Broker',
      description: 'Mortgage broker Bao Nguyen serves Alhambra, Monterey Park, San Gabriel, Rosemead, Temple City, El Monte, Arcadia and West Covina. Local data by city.',
      crumb: 'Areas',
      h1: 'Mortgage broker serving the San Gabriel Valley',
      lead: `I help San Gabriel Valley homeowners and buyers refinance, take cash out, and buy or sell homes, in English or Vietnamese. Every city below is in Los Angeles County, so the ${loanLimits.year} conforming loan limit is ${usd(loanLimits.conforming.oneUnit)} for a one-unit home. Pick your city to see local home values, how many homes are owner-occupied, and which down payment programs apply there.`,
      value: 'Median home value',
      owners: 'Owner-occupied',
      hopYes: 'County HOP down payment help available',
      hopNo: 'Not in the county HOP program',
      more: "Don't see your city? I serve the whole San Gabriel Valley and all of Los Angeles County. Call or text.",
      source: 'Source',
    };
const crumbs = [
  { name: tr.home, path: p('/') },
  { name: copy.crumb, path },
];
const hopCities = cities.filter((c) => cityFacts(c).inHop).map((c) => c.name);
const listJoin = (a: string[], and: string) => (a.length < 2 ? a.join('') : `${a.slice(0, -1).join(', ')} ${and} ${a.at(-1)}`);
const lim = usd(loanLimits.conforming.oneUnit);
const faq: [string, string][] = vi
  ? [
      ['Hạn mức vay có khác nhau giữa các thành phố ở San Gabriel Valley không?', `Không. Mọi thành phố trên trang này đều thuộc Quận Los Angeles, nên hạn mức năm ${loanLimits.year} giống nhau: ${lim} cho khoản vay conforming và FHA đối với nhà một căn.`],
      ['Thành phố nào được hỗ trợ tiền trả trước của Quận Los Angeles?', `Trong các thành phố trên, ${listJoin(hopCities, 'và')} nằm trong danh sách Chương trình Sở hữu Nhà (HOP) của LACDA. Người mua ở các thành phố khác vẫn có thể dùng chương trình toàn tiểu bang CalHFA MyHome.`],
      ['Bạn có phục vụ thành phố không có trong danh sách không?', 'Có. Tôi phục vụ toàn bộ San Gabriel Valley và cả Quận Los Angeles, bằng tiếng Việt hoặc tiếng Anh. Hãy gọi hoặc nhắn tin.'],
    ]
  : [
      ['Are loan limits different in each San Gabriel Valley city?', `No. Every city on this page is in Los Angeles County, so the ${loanLimits.year} limits are the same everywhere: ${lim} for conforming and FHA loans on a one-unit home.`],
      ['Which cities qualify for Los Angeles County down payment help?', `Of the cities above, ${listJoin(hopCities, 'and')} are on LACDA's Home Ownership Program list. Buyers in the other cities can still use statewide programs such as CalHFA MyHome.`],
      ['Do you serve cities that are not listed here?', 'Yes. I serve the whole San Gabriel Valley and the rest of Los Angeles County, in English or Vietnamese. Call or text.'],
    ];
---
<BaseLayout title={copy.title} description={copy.description} path={path} crumbs={crumbs} lang={lang} schema={[faqLd(faq, lang)]}>
  <section class="wrap hub">
    <h1>{copy.h1}</h1>
    <p class="lead">{copy.lead}</p>
    <ul class="grid">
      {cities.map((c) => {
        const f = cityFacts(c);
        return (
          <li class="card">
            <h2><a href={p(`/areas/${c.slug}/`)}>{c.name}</a></h2>
            <p>{copy.value}: <strong>{usd(c.medianValue)}</strong></p>
            <p>{copy.owners}: <strong>{c.ownerRate}%</strong></p>
            <p class="hop">{f.inHop ? copy.hopYes : copy.hopNo}</p>
          </li>
        );
      })}
    </ul>
    <p>{copy.more}</p>
    <Faq heading={vi ? 'Câu hỏi thường gặp' : 'Frequently asked questions'} items={faq} />
    <p class="source">
      {copy.source}: <a href={CENSUS_SOURCE.url} rel="noopener">{CENSUS_SOURCE.name}</a>;
      <a href={hop.source.url} rel="noopener">{hop.source.name}</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .hub {
    padding-block: 1.5rem 0;
  }
  .lead {
    font-size: 1.1875rem;
    color: var(--ink-soft);
    max-width: 48rem;
  }
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .grid h2 {
    margin: 0 0 0.5rem;
    font-size: 1.375rem;
  }
  .grid h2 a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .grid p {
    margin: 0 0 0.25rem;
  }
  .hop {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  .source {
    line-height: 1.9;
  }
</style>
