---
import { site, agent, nav, formatPhone, telHref } from '../config/site';
const items = nav.filter((n) => n.ready);
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="brand-name">{site.name}</span>
      <span class="brand-sub">{agent.name} · {agent.title}</span>
    </a>
    {items.length > 0 && (
      <nav aria-label="Main">
        <ul>
          {items.map((i) => (
            <li>
              <a href={i.href} aria-current={current.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <a class="btn btn-primary call" href={telHref(agent.phone)}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"/></svg>
      <span>Call {formatPhone(agent.phone)}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--sand-200);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    min-height: 44px;
    justify-content: center;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--jade-900);
    line-height: 1.2;
  }
  .brand-sub {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    border-radius: var(--radius-sm);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--jade-100);
    color: var(--jade-900);
  }
  .call {
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
  }
  @media (max-width: 480px) {
    .call {
      width: 100%;
    }
  }
</style>
