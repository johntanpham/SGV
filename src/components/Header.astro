---
import { site, agent, nav, formatPhone, telHref } from '../config/site';
import { t, viPath, type Lang } from '../i18n/strings';
interface Props {
  lang?: Lang;
  twin?: string | null;
}
const { lang = 'en', twin = null } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'en' ? 'vi' : 'en';
const items = nav.filter((n) => n.ready).map((n) => ({ ...n, label: lang === 'vi' ? n.labelVi : n.label, href: lang === 'vi' ? viPath(n.href) : n.href }));
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={lang === 'vi' ? '/vi/' : '/'}>
      <span class="brand-name">{site.name}</span>
      <span class="brand-sub">{agent.name} · {agent.title}</span>
    </a>
    {items.length > 0 && (
      <nav aria-label={tr.mainNav}>
        <ul>
          {items.map((i) => (
            <li>
              <a href={i.href} aria-current={current.startsWith(i.href) ? 'page' : undefined}>{i.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <div class="actions">
    {twin && (
      <a class="lang-switch" href={twin} hreflang={other} lang={other} aria-label={tr.switchAria}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-9 9h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z"/></svg>
        <span>{tr.switchLabel}</span>
      </a>
    )}
    <a class="btn btn-primary call" href={telHref(agent.phone)}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z"/></svg>
      <span>{tr.call} {formatPhone(agent.phone)}</span>
    </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--sand-200);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    min-height: 44px;
    justify-content: center;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--jade-900);
    line-height: 1.2;
  }
  .brand-sub {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    border-radius: var(--radius-sm);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--jade-100);
    color: var(--jade-900);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 2px solid var(--jade-800);
    border-radius: 999px;
    color: var(--jade-800);
    font-weight: 700;
    text-decoration: none;
  }
  .lang-switch:hover {
    background: var(--jade-100);
  }
  .call {
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .actions {
      width: 100%;
    }
    .call {
      flex: 1;
      padding-inline: 0.75rem;
    }
    nav ul {
      gap: 0;
    }
    nav a {
      padding: 0 0.5rem;
      font-size: 0.9375rem;
    }
  }
</style>
