---
import { site } from '../config/site';
import { canonicalUrl, graph, websiteLd, organizationLd, agentLd, breadcrumbLd, type Crumb } from '../lib/seo';
import { isPreview } from '../lib/mode';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs: Crumb[];
  /** false = "noindex, follow" (long-tail pages that open in batches). */
  indexable?: boolean;
  /** Extra JSON-LD nodes for this page type (Article, FAQPage, Dataset ...). */
  schema?: object[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  lang?: string;
}

const {
  title,
  description,
  path,
  crumbs,
  indexable = true,
  schema = [],
  ogImage = '/og/default.png',
  ogType = 'website',
} = Astro.props;

const canonical = canonicalUrl(path);
const hidden = isPreview();
const robots = hidden || !indexable ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const ogUrl = new URL(ogImage, site.origin).href;
const ld = graph([websiteLd(), organizationLd(), agentLd(), breadcrumbLd(crumbs), ...schema]);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
